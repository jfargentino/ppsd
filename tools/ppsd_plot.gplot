#reset

#if (defined(PNG_FILE))
#    set terminal png
#    set output 'TOTO.png'
set terminal png
set output sprintf('%s.png', PPS_OFFSET_FILE)

set datafile separator ','

set xdata time # tells gnuplot the x axis is time data
set timefmt "%s" ## specify our time string format "%Y-%m-%dT%H:%M:%S"
#set format x "%H:%M:%S" # otherwise it will show only MM:SS

set grid ls 100
set ylabel "PPS offset (ns)"

#plot PPS_OFFSET_FILE using 1:3 with lines
plot PPS_OFFSET_FILE using 1:2 with lines
